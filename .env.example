# Copy to .env for local preview. On Netlify, set these in Site configuration › Environment variables.
GIVEBUTTER_API_KEY=your-givebutter-api-key
ADMIN_PASSWORD=choose-a-staff-password
WEBHOOK_SECRET=choose-a-long-random-secret
# Texting raffle ticket numbers (Twilio, with your approved 10DLC campaign)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Card payments on the Stripe Reader M2 (via the SRS Card Terminal iPhone app). Use sk_test_ to practice.
STRIPE_SECRET_KEY=your-stripe-secret-key
# Optional: an existing Stripe Terminal location (otherwise one is created automatically)
# STRIPE_TERMINAL_LOCATION=tml_xxxxxxxxxxxx
